<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZeroAuto 零度车控 · 控制中心"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="本地优先架构：基础车控/导航/音乐纯离线秒级响应。"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#2C2C2E" />

        <!-- 模块一：交互与功能开关控制 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车载功能与交互开关"
            android:textColor="#0A84FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 离线唤醒开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="离线语音唤醒 (Sherpa-ONNX)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_wakeup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 唤醒词自定义 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义唤醒词："
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_wakeup_word"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:background="#1C1C1E"
                android:hint="大黄蜂"
                android:paddingHorizontal="10dp"
                android:textColor="#30D158"
                android:textColorHint="#48484A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="(拼音音素对齐，免训练)"
                android:textColor="#636366"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 免唤醒高频指令直达 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="高频免唤醒词表直达 (如切歌/关窗/息屏)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_quick_cmd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 桌面悬浮球开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="桌面触控悬浮球 (随时点击唤醒/拖动停靠)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_float_ball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 开机自启动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="车机点火/开机自启动守护"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_boot_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 媒体声音闪避压制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="播报时压制音乐音量 (音频闪避 Ducking)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_audio_duck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- UI 显示模式切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="车载大字居中卡片弹窗 (关闭即为纯语音模式)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_card_ui"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#2C2C2E" />

        <!-- 模块二：云端能力授权入口按钮 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="云端增值能力与授权管理"
            android:textColor="#30D158"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="大模型百科/闲聊外脑，以及异地多天心知天气授权。"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <!-- 聚合授权入口按钮 -->
        <Button
            android:id="@+id/btn_open_auth_dialog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#2C2C2E"
            android:text="🔐 云端能力授权设置 (大模型 + 心知天气)"
            android:textColor="#30D158"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_auth_status_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="当前状态：大模型 [未授权] · 心知天气 [未授权]"
            android:textColor="#FF9F0A"
            android:textSize="12sp" />

        <!-- 底部主控按钮 -->
        <Button
            android:id="@+id/btn_save_and_apply"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#0A84FF"
            android:text="保存配置并启动车机助手"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_trigger_test_card"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1C1C1E"
            android:text="🎯 立即呼出车载居中卡片 UI"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
