<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090B10"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZEROAUTO 2.0" android:textColor="#F8FAFC" android:textSize="26sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本地优先 · 车载级语音交互控制台" android:textColor="#94A3B8" android:layout_marginBottom="16dp"/>
<com.incar.assistant.ui.ThemeInteractionView android:id="@+id/theme_preview" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginBottom="12dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/theme_orb" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="拟人光球"/><Button android:id="@+id/theme_capsule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="灵动岛"/><Button android:id="@+id/theme_aurora" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="沉浸极光"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 · 语音感知与免唤醒" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="22dp"/><Switch android:id="@+id/switch_wakeup" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sherpa-ONNX 离线常驻唤醒" android:textColor="#FFFFFF"/><EditText android:id="@+id/edit_wakeup" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="自定义唤醒词" android:textColor="#FFFFFF" android:textColorHint="#64748B"/><Switch android:id="@+id/switch_quick" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="高频免唤醒词直达" android:textColor="#FFFFFF"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02 · 视觉交互与动效" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp"/><Switch android:id="@+id/switch_float" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="悬浮球常驻与边缘吸附" android:textColor="#FFFFFF"/><Switch android:id="@+id/switch_reactive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="音乐律动互动" android:textColor="#FFFFFF"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03 · 声音通道与车载音乐" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp"/><Spinner android:id="@+id/spinner_music" android:layout_width="match_parent" android:layout_height="wrap_content"/><SeekBar android:id="@+id/seek_music" android:layout_width="match_parent" android:layout_height="wrap_content"/><SeekBar android:id="@+id/seek_voice" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/switch_duck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="智能音频闪避：播报时音乐降至 20%" android:textColor="#FFFFFF"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04 · 角色语音与发音人风格" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp"/><Spinner android:id="@+id/spinner_voice" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/button_preview_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="试听本地 TTS"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05 · 智驾网络与增值授权" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp"/><EditText android:id="@+id/edit_llm_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="10Router 网关端点 URL" android:textColor="#FFFFFF"/><EditText android:id="@+id/edit_llm_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API Key" android:inputType="textPassword" android:textColor="#FFFFFF"/><EditText android:id="@+id/edit_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="模型名称：cx/gpt-5.6-luna" android:textColor="#FFFFFF"/><EditText android:id="@+id/edit_weather_uid" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="心知天气 UID" android:textColor="#FFFFFF"/><EditText android:id="@+id/edit_weather_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="心知天气私钥" android:inputType="textPassword" android:textColor="#FFFFFF"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06 · 车机自启与系统守护" android:textColor="#38BDF8" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="16dp"/><Switch android:id="@+id/switch_boot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACC / BOOT_COMPLETED 自启守护" android:textColor="#FFFFFF"/><Button android:id="@+id/button_overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="检查悬浮窗权限"/><Button android:id="@+id/button_save" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:text="保存并启动 ZeroAuto" android:textStyle="bold"/>
</LinearLayout></ScrollView>
